from Standard.Base import all

from Standard.Table import Table

from project.Table_Extensions import Distance_Units, _to_radians

type Geo
    ## UNSTABLE
       ICON location

       Create a `Table` representing a geographic point with the specified latitude,
       longitude, and elevation.

       Arguments:
       - latitude: The latitude of the geographic point, specified in decimal form
         using the [WGS84](https://en.wikipedia.org/wiki/World_Geodetic_System)
         coordinate system.
       - longitude: The longitude of the geographic point, specified in decimal form
         using the [WGS84](https://en.wikipedia.org/wiki/World_Geodetic_System)
         coordinate system.
       - elevation: The elevation of the point from sea level, in metres.

       > Example
         Create a point representing the centre of London.

             import Standard.Geo

             example_point = Geo.point 51.509865 -0.118092
    point latitude:Float longitude:Float elevation:Float=0 -> Table =
        Table.new [["latitude", [latitude]], ["longitude", [longitude]], ["elevation", [elevation]]]

    ## UNSTABLE
       ICON geo_map_distance

       Computes the distance between two latitude/longitude points

       Arguments:
       - lat1: The latitude of the first point.
       - long1: The longitude of the first point.
       - lat2: The latitude of the second point.
       - long2: The longitude of the second point.
       - units: The unit to return the result in.
    distance self lat1:Float=(Missing_Argument.throw "lat1") long1:Float=(Missing_Argument.throw "long1") lat2:Float=(Missing_Argument.throw "lat2") long2:Float=(Missing_Argument.throw "long2") units:Distance_Units=..Meters -> Float =
        rLat1 = _to_radians lat1
        rLat2 = _to_radians lat2
        rLng1 = _to_radians long1
        rLng2 = _to_radians long2

        dLat = rLat2 - rLat1
        sinDLat = ((dLat/2).sin)^2
        dLng = rLng2 - rLng1
        sinDLng = ((dLng/2).sin)^2

        cosLat1 = rLat1.cos
        cosLat2 = rLat2.cos

        product = cosLat1 * cosLat2 * sinDLng + sinDLat
        (units.from_meters (product.sqrt.asin*2*6371000)).round 1
