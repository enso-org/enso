from Standard.Base import all

type Omitter
    Value ~err

    loc self =
        stack_trace = Runtime.get_stack_trace
        #pst "full" stack_trace

        omitting_index = stack_trace.last_index_of (frame-> frame.name == "Omitter.omitting")
        real_stack_trace = stack_trace.drop (omitting_index + 2)

        #IO.println "OI "+omitting_index.to_text
        #pst "real" real_stack_trace

        top = real_stack_trace . at 0 . source_location
        top.to_display_text

omitting default_omitter ~action =
    omitter = default_omitter.if_nothing (Omitter.Value (Error.throw "here"))
    IO.println "AAAAA "+omitter.loc.to_display_text
    action omitter
