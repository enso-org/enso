from Standard.Base import all
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument

import project.Prototype.My_Base_Column.My_Base_Column
import project.Prototype.My_In_Memory_Column.My_In_Memory_Column
import project.Prototype.Impl.DB_Column_Implementation.DB_Column_Implementation

type My_DB_Column
    private Value internal_name:Text sql:Text

    ## Returns the SQL query corresponding to this column.
    to_sql self -> Text = self.sql

    ## Materializes the column into an in-memory column.
    read self -> My_Base_Column =
        My_Base_Column.from_vector self.internal_name []

    create name:Text -> My_Base_Column & My_DB_Column =
        My_DB_Column.Value name ("SELECT "+name+" FROM table")

    to_text self -> Text =
        "My_DB_Column "+self.internal_name


My_Base_Column.from (that:My_DB_Column) =
    My_Base_Column.Value that DB_Column_Implementation

My_DB_Column.from (_:My_In_Memory_Column) =
    Error.throw (Illegal_Argument.Error "Cannot use in-memory column in database context, please upload a table to the database using select_into_database_table.")

My_In_Memory_Column.from (_:My_DB_Column) =
    Error.throw (Illegal_Argument.Error "Cannot use database column with in-memory columns, please materialize the column using `.read`.")
