private

from Standard.Base import all
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument

import project.Prototype.My_DB_Column.My_DB_Column

type DB_Column_Implementation
    name column = column.internal_name
    to_vector column =
        _ = column
        []
    length column =
        _ = column
        -1

    fill_nothing column other:My_DB_Column =
        other.if_not_error <|
            # just to get some value...
            My_DB_Column.create column.internal_name+"-fill_nothing"
