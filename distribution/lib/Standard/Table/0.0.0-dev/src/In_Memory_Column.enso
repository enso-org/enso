from Standard.Base import all
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument

import project.Column.Column
import project.Internal.In_Memory_Column_Implementation.In_Memory_Column_Implementation
import project.Internal.Visualization_Helpers.Visualization_Helpers
import project.Internal.In_Memory_Visualization_Helpers.In_Memory_Visualization_Helpers
from project.Column import column_from_implementation

## A column whose data is stored in memory.
type In_Memory_Column
    ## PRIVATE
       Internal constructor that should not be used directly.
       Please use `from_java_column` instead.

       Arguments:
       - internal_java_column: The internal representation of the column.
    private Value internal_java_column

    ## PRIVATE
       A getter that is a workaround for bug https://github.com/enso-org/enso/issues/12180
    private java_column self = self.internal_java_column

    ## PRIVATE
    pretty : Text
    pretty self =
        name = self.name.pretty
        data = self.to_vector.pretty
        "Column.from_vector " + name + " " + data

Column.from (that : In_Memory_Column) =
    column_from_implementation that In_Memory_Column_Implementation

In_Memory_Column.from (that : Column) =
    if that.underlying.is_a In_Memory_Column then that.underlying else
        Error.throw (Illegal_Argument.Error "Expected an in-memory column but got " + that.to_text)

Visualization_Helpers.from (that : In_Memory_Column) =
    Visualization_Helpers.Value that In_Memory_Visualization_Helpers
