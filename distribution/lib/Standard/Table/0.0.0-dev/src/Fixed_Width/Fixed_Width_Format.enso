from Standard.Base import all
import Standard.Base.Errors.Illegal_Argument.Illegal_Argument
import Standard.Base.Runtime.Ref.Ref
import Standard.Base.System.File_Format_Metadata.File_Format_Metadata
import Standard.Base.System.Input_Stream.Input_Stream

import project.Data_Formatter.Data_Formatter
import project.Delimited.Invalid_Fixed_Width_Rows.Invalid_Fixed_Width_Rows
import project.Internal.Fixed_Width_Reader
import project.Internal.Telemetry
import project.Table.Table

## Read fixed-width files into a Table.

   A fixed-width format defines its columns as fixed column offsets and widths.
   The columns are defined in a `Fixed_Width_Layout` object.
type Fixed_Width_Format
    ## Read fixed-width files into a Table.

    Fixed_Width (layout:Fixed_Width_Layout) (encoding:Encoding=Encoding.default) (on_invalid_rows:Invalid_Fixed_Width_Rows=..Keep_Invalid_Rows) (value_formatter:Data_Formatter|Nothing=Data_Formatter.Value)

    ## PRIVATE
       Resolve an unresolved constructor to the actual type.
    resolve : Function -> Fixed_Width_Format | Nothing
    resolve constructor =
        _ = constructor
        Nothing

    ## PRIVATE
       ADVANCED
       Implements the `File.read` for this `File_Format`
    read : File -> Problem_Behavior -> Any
    read self file on_problems:Problem_Behavior =
        result = Fixed_Width_Reader.read_file self file on_problems
        result.if_not_error <|
            Telemetry.log "File_Format.read" "Read file: format={}, output={}, row_count={}, column_count={}" ["Fixed_Width_Format", "Table", result.row_count, result.column_count]
            result

    ## PRIVATE
       Implements decoding the format from a stream.
    read_stream : Input_Stream -> File_Format_Metadata -> Any
    read_stream self stream:Input_Stream (metadata : File_Format_Metadata = File_Format_Metadata.no_information) =
        _ = metadata
        Fixed_Width_Reader.read_stream self stream on_problems=..Report_Warning

## PRIVATE
   Specifies a fixed-width column. A column can be specified as a start column
   and a witdh, or by just a width, relative to the previous column.
type Fixed_Width_Column_Description
    Start_And_Width (name : Text | Nothing) (start:Integer) (width:Integer)
    Width (name : Text | Nothing) (width:Integer)

## PRIVATE
   Specifies a fixed-width column as a start and a width.
type Fixed_Width_Layout_Entry
    Value (name:Text) (start:Integer) (width:Integer)

## PRIVATE
   Specifies a set of fixed-width columns.
type Fixed_Width_Layout
    private Value (entries : Vector Fixed_Width_Layout_Entry)

    from_descriptions (descs : Vector Fixed_Width_Column_Description) -> Fixed_Width_Layout =
        if descs.is_empty then
            Error.throw (Illegal_Argument.Error "A fixed-width layout must have at least one column.")

        starts = Vector.build builder->
            go i current =
                if i >= descs.length then Nothing else
                    desc = descs.at i
                    if desc.width <= 0 then
                        Error.throw (Illegal_Argument.Error "A fixed-width layout column must have a width of 1 or more.")
                    start = case desc of
                        Fixed_Width_Column_Description.Start_And_Width _ start _ ->
                            if desc.start < 0 then
                                Error.throw (Illegal_Argument.Error "A fixed-width layout column start cannot be negative.")
                            if start < current then Error.throw (Illegal_Argument.Error "Entry "+desc.to_text+" must start at column "+current.to_text+" or later") else
                                start
                        Fixed_Width_Column_Description.Width _ _ ->
                            current
                    builder.append start
                    width = desc.width
                    @Tail_Call go (i + 1) (start + width)
            go 0 0

        namer = Column_Namer.new "Column"
        entries = starts.zip descs start-> desc->
            name = desc.name.if_nothing namer.next
            Fixed_Width_Layout_Entry.Value name start desc.width
        Fixed_Width_Layout.Value entries

    ## PRIVATE
    get_entries self -> Vector = self.entries

Fixed_Width_Layout.from (that:Table) =
    num_cols = that.columns.length
    if num_cols != 2 && num_cols != 3 then
        Error.throw (Illegal_Argument.Error "A fixed-width column specification must have two or three columns (optional column name; start; width).")
    has_names = num_cols == 3
    names = if has_names then that.columns.at 0 . to_vector else Nothing
    starts = if has_names then that.columns.at 1 . to_vector else that.columns.at 0 . to_vector
    widths = if has_names then that.columns.at 2 . to_vector else that.columns.at 1 . to_vector
    descs = 0.up_to that.row_count . map i->
        name = if names.is_nothing then Nothing else names.at i
        start = starts.at i
        width = widths.at i
        if start.is_nothing then Fixed_Width_Column_Description.Width name width else
            Fixed_Width_Column_Description.Start_And_Width name start width
    Fixed_Width_Layout.from_descriptions descs

## PRIVATE
   Helper for generating column names.
type Column_Namer
    Value (prefix : Text) (next_ref : Ref)

    new (prefix : Text) -> Column_Namer = Column_Namer.Value prefix (Ref.new 1)

    next self -> Text = self.prefix.to_text + " " + (self.next_ref.modify (+1)).to_text
