import project.Data.Text.Text
import project.Email.Email_Object.Email_Object
import project.Data.Json.JS_Object
import project.Network.HTTP.Header.Header
import project.Data
import project.Data.Pair.pair
import project.Email.Email_Send_Response.Send_Response
import project.System.File.File

polyglot java import java.util.Base64

type Email_Provider
    TestProvider
    SendGrid api_key:Text
    SMTP server:Text port username:Text password:Text use_tls

    send self email:Email_Object = case self of
        Email_Provider.TestProvider -> Send_Response.Test email
        Email_Provider.SendGrid api_key -> sendgrid_email email api_key
        Email_Provider.SMTP server port username password use_tls -> Send_Response.Test email

sendgrid_email email:Email_Object api_key:Text =
    to_object = JS_Object.from_pairs [["to", email.to.map create_to_email], ["cc", email.cc.map create_to_email], ["bcc", email.bcc.map create_to_email]]
    base_email_pairs = [["personalizations", [to_object]], ["from", (JS_Object.from_pairs [["email", email.from_address]])], ["subject", email.subject], ["content", [prepare_html_body email.body.body]]]

    attachment_list = if email.attachments.length == 0 then [] else email.attachments.map prepare_attachment
    final_email_pairs = if email.attachments.length == 0 then base_email_pairs else base_email_pairs + [pair "attachments" attachment_list]
    sendgrid_request_body = JS_Object.from_pairs final_email_pairs

    api_response = Data.post 'https://api.sendgrid.com/v3/mail/send' (..Json sendgrid_request_body) headers=[Header.authorization_bearer api_key]
    api_response

create_to_email recipient_email =
    recipient_object = JS_Object.from_pairs [["email", recipient_email]]
    recipient_object

prepare_html_body html_content =
    html_body_object = JS_Object.from_pairs [pair "type" "text/html", pair "value" html_content]
    html_body_object

prepare_attachment file_path =
    file_handle = File.new file_path
    file_bytes = file_handle.read_bytes
    encoded_content = Base64.getEncoder.encodeToString file_bytes
    filename = file_handle.name
    attachment_object = JS_Object.from_pairs [pair "content" encoded_content, pair "type" "text/plain", pair "filename" filename]
    attachment_object
