import project.Data.Text.Text
import project.Email.Email_Object.Email_Object
import project.Data.Json.JS_Object
import project.Network.HTTP.Header.Header
import project.Data
import project.Data.Pair.pair
import project.Email.Email_Send_Response.Send_Response

type Email_Provider
    TestProvider
    SendGrid api_key:Text
    SMTP server:Text port username:Text password:Text use_tls

    send self email:Email_Object = case self of
        Email_Provider.TestProvider -> Send_Response.Test email
        Email_Provider.SendGrid api_key -> sendgrid_email email api_key
        Email_Provider.SMTP server port username password use_tls -> Send_Response.Test email

sendgrid_email email:Email_Object api_key:Text =
    recipient_list = ["riley.ad@gmail.com"].map create_to_email
    personalization_object = JS_Object.from_pairs [pair "to" recipient_list]
    base_email_pairs = [pair "personalizations" [personalization_object], pair "from" (JS_Object.from_pairs [pair "email" "adam.riley@enso.org", pair "name" "Adam Riley"]), pair "subject" "Test123", pair "content" [prepare_html_body "Hello, World!"]]
    sendgrid_request_body = JS_Object.from_pairs base_email_pairs 
    api_response = Data.post 'https://api.sendgrid.com/v3/mail/send' (..Json sendgrid_request_body) headers=[Header.authorization_bearer api_key]
    api_response

create_to_email recipient_email =
    recipient_object = JS_Object.from_pairs [pair "email" recipient_email]
    recipient_object

prepare_html_body html_content =
    html_body_object = JS_Object.from_pairs [pair "type" "text/html", pair "value" html_content]
    html_body_object
