private

import project.Data.Boolean.Boolean
import project.Data.Text.Text
import project.System.File.File
import project.System.File_Format.Bytes
import project.System.File_Format.File_Format_SPI
import project.System.File_Format.JSON_Format
import project.System.File_Format.Plain_Text_Format

polyglot java import java.nio.file.Path as Java_Path
polyglot java import java.nio.file.Files as Java_Files
polyglot java import java.nio.file.LinkOption as Java_LinkOption

## The builtin that returns a File instance for a given path.
get_file path:Text =
    File.Value (Java_Path.of path)

is_directory_builtin file:File -> Boolean =
    Java_Files.isDirectory file.java_path

is_regular_file_builtin file:File -> Boolean =
    Java_Files.isRegularFile file.java_path

resolve_builtin file:File part:Text -> File =
    new_path = file.java_path.resolve part
    File.Value new_path

delete_builtin file:File recursive:Boolean =
    should_delete_recursively = recursive && is_dir file
    if should_delete_recursively then delete_recursively file else
        Java_Files.delete file.java_path

delete_recursively path:Java_Path =
    if is_dir.not path then Java_Files.delete path else
        children = Java_Files.list path . toList
        children.each \child ->
            delete_recursively child

is_dir file:(File|Java_Path) -> Boolean =
    path = case file of
        _ : File -> file.java_path
        p : Java_Path -> p
    Java_Files.is_directory path Java_LinkOption.NOFOLLOW_LINKS


## Converts `java.nio.file.attribute.FileTime` to Enso `Date_Time`.
file_time_to_date_time file_time -> Date_Time =
    instant = file_time.toInstant
    zoned_dt = Java_ZonedDateTime.ofInstant instant Java_ZoneOffset.UTC
    Date_Time.new zoned_dt.getYear zoned_dt.getMonthValue zoned_dt.getDayOfMonth zoned_dt.getHour zoned_dt.getMinute zoned_dt.getSecond zoned_dt.getNano Time_Zone.utc


read_last_bytes_builtin file n = @Builtin_Method "File.read_last_bytes_builtin"

## Creates a new output stream for this file. Recommended to use
   `File.with_output_stream` instead, which does resource management.

   ## Arguments
    - `options`: A vector of `File_Access` objects determining how to open the
      stream. These options set the access properties of the stream.
output_stream_builtin file options = @Builtin_Method "File.output_stream_builtin"

## Creates a new input stream for this file. Recommended to use
   `File.with_input_stream` instead, which does resource management.

   ## Arguments
    - `options`: A vector of `StandardOpenOption` polyglot objects determining
      how to open the stream. These options set the access properties of the
      stream.
input_stream_builtin file options = @Builtin_Method "File.input_stream_builtin"

## registration of basic file format implementations
type Default_File_Formats
File_Format_SPI.from (that:Default_File_Formats) =
    _ = that
    bytes = File_Format_SPI.new Bytes
    json = File_Format_SPI.new JSON_Format "json"
    plain = File_Format_SPI.new Plain_Text_Format
    bytes+json+plain
