## ---
   aliases: [mail]
   group: Web
   icon: email
   ---
   Sends an email.
@from Email_Address.default_widget
@to Email_Address.vector_widget
@cc Email_Address.vector_widget
@bcc Email_Address.vector_widget
@attachments (Vector_Editor Email_Attachment.default_widget item_default='Email_Attachment.File')
@body Email_Body.default_widget
send from:Email_Address=(Missing_Argument.throw "from") (to:Vector Email_Address)=[] (cc:Vector Email_Address)=[] (bcc:Vector Email_Address)=[] (subject:Text)="" (body:Email_Body)="" (attachments:Vector Email_Attachment)=[] (provider:Email_Provider=(Missing_Argument.throw "provider")) =
    email_object = Email_Object.Value from to cc bcc subject body attachments
    provider.send email_object
