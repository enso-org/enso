## An email provider for sending emails. In the future this will be replaced by an SPI system and move the implementation out of the Base library.
type Email_Provider
    send provider email:Email = case provider of
        _ : Function -> (Email_Provider_SPI.resolve_constructor provider) . send email
        _ -> provider.send2 email

    ## ---
       private: true
       ---
    default_widget display:Display=..When_Modified -> Widget =
        options = Email_Provider_SPI._get_known_email_providers.flat_map .get_dropdown_options
        Single_Choice display=display values=options

## ---
   private: true
   ---
   Internal class for enabling SPI for Email_Provider types.
type Email_Provider_SPI
    private Value typ

    ## ---
       private: true
       ---
    new typ -> Email_Provider_SPI = Email_Provider_SPI.Value typ

    private resolve_constructor constructor:Function =
        types = Email_Provider_SPI._get_known_email_providers
        try_next idx =
            if idx >= types.length then constructor else
                db_type = types.at idx
                resolved = db_type.resolve constructor
                if resolved==Nothing then @Tail_Call try_next (idx + 1) else resolved
        try_next 0

    private _get_known_email_providers -> Vector =
        Meta.lookup_services Email_Provider_SPI . map .typ
