import project.Data.Text.Text
import project.Metadata.Display
import project.Metadata.Widget
from project.Metadata.Choice import Option
from project.Metadata.Widget import Text_Input, Vector_Editor, Single_Choice

## The body of an email.
type Email_Body
    ## A plain text email body.
    Plain_Text body:Text

    ## An HTML email body. With an optional plain text fallback.
    HTML html:Text body:Text=""
     
    ## ---
       private: true
       ---
    default_widget (display : Display = ..Always) -> Widget =
        plain = [Option "Plain_Text" "Email_Body.Plain_Text ''"]
        html = [Option "HTML" "Email_Body.HTML '' ''"]
        values = plain + html
      
        Single_Choice values=values display=display

## ---
   private: true
   ---
Email_Body.from (that:Text) = Email_Body.Plain_Text that
