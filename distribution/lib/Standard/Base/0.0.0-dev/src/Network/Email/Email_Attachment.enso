import project.System.File.File
from project.Metadata.Choice import Option
from project.Metadata.Widget import Text_Input, Vector_Editor, Single_Choice
import project.Metadata.Widget
import project.Metadata.Display

## The attachment of an email.
type Email_Attachment
    ## A file attachment.
	File file:File

	## ---
       private: true
       ---
   default_widget (display : Display = ..Always) -> Widget =
      name = [Option "New Attachment" "Email_Attachment.File"]
      values = name

      Single_Choice values=values display=display

    ## ---
       private: true
       ---
	vector_widget (display : Display = ..Always) -> Widget =
		Vector_Editor Email_Attachment.default_widget item_default='Email_Attachment.File' display=display
