import project.Errors.Common.Type_Error
import project.Panic.Panic
from project.Metadata.Choice import Option
import project.Nothing.Nothing
import project.Warning.Warning
import project.Network.Email.Email
import project.Network.Email.Email_Provider.Email_Provider_SPI
import project.Network.Email.Email_Send_Response.Send_Response

type Email_Provider_Test_Only_Impl

Email_Provider_SPI.from (that:Email_Provider_Test_Only_Impl) =
    _ = that
    Email_Provider_SPI.new Email_Provider_Test_Only

## A test email provider that does not send any emails. Used for testing workflows.
type Email_Provider_Test_Only
    Test_Only

    send self email:Email =
        warning = "Test_Only Email Provider used: no email was actually sent."
        Warning.attach warning (Send_Response.Test email)

    get_dropdown_options = [Option "..Test_Only" "..Test_Only"]

    ## ---
       private: true
       ---
    resolve value =
        Panic.catch Type_Error (value:Email_Provider_Test_Only) _->Nothing