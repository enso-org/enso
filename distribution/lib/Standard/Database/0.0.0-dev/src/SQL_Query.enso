from Standard.Base import Missing_Argument, Text

type SQL_Query
    ## Query a whole table or view with a schema.
    Table_And_Schema (name : Text = Missing_Argument.throw "name") (schema : Text = Missing_Argument.throw "schema")

    ## Query a whole table or view.
    Table_Name (name : Text = Missing_Argument.throw "name")

    ## Raw SQL query statement.
    Raw_SQL (sql : Text = Missing_Argument.throw "sql")

## ---
   private: true
   ---
SQL_Query.from (that:Text) = SQL_Query.Table_Name that
