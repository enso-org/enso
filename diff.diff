@@ -0,0 +1,107 @@
+//! Functionality for embedding resources into Windows PE executables at runtime.
+//!
+//! This module provides the ability to add binary resources (like the installer payload)
+//! into an already-compiled executable. This is used in the Bazel build where the installer
+//! binary is built separately from the payload creation.
+
+use crate::prelude::*;
+
+/// Resource type for arbitrary binary data (RCDATA).
+///
+/// See https://learn.microsoft.com/en-us/windows/win32/menurc/resource-types
+pub const RT_RCDATA: u16 = 10;
+
+/// Embeds a binary resource into a Windows PE executable.
+///
+/// This function uses the Windows Resource API to add a binary resource to an existing
+/// executable file. The resource can later be retrieved at runtime using `FindResource`
+/// and `LoadResource`.
+///
+/// # Arguments
+/// * `executable_path` - Path to the PE executable to modify
+/// * `resource_id` - String identifier for the resource (e.g., "INSTALLER_PAYLOAD")
+/// * `data` - The binary data to embed
+///
+/// # Platform
+/// This function only works on Windows. On other platforms, it will return an error.
+#[cfg(windows)]
+pub fn embed_binary_resource(executable_path: &Path, resource_id: &str, data: &[u8]) -> Result<()> {
+    use std::ffi::c_void;
+    use std::ffi::OsStr;
+    use std::os::windows::ffi::OsStrExt;
+    use windows::core::PCWSTR;
+    use windows::Win32::System::LibraryLoader::{
+        BeginUpdateResourceW, EndUpdateResourceW, UpdateResourceW,
+    };
+
+    // Convert path to wide string for Windows API
+    let wide_path: Vec<u16> =
+        OsStr::new(executable_path).encode_wide().chain(std::iter::once(0)).collect();
+
+    // Convert resource ID to wide string
+    let wide_id: Vec<u16> =
+        OsStr::new(resource_id).encode_wide().chain(std::iter::once(0)).collect();
+
+    // Begin updating resources
+    let handle = unsafe { BeginUpdateResourceW(PCWSTR(wide_path.as_ptr()), false) }
+        .context("Failed to begin updating resources. Is the file locked?")?;
+
+    // Add the resource
+    // RT_RCDATA = 10, language neutral = 0
+    let result = unsafe {
+        UpdateResourceW(
+            handle,
+            PCWSTR(RT_RCDATA as *const u16),
+            PCWSTR(wide_id.as_ptr()),
+            0, // Language neutral
+            Some(data.as_ptr() as *const c_void),
+            data.len() as u32,
+        )
+    };
+
+    if let Err(e) = result {
+        // Try to discard changes on error
+        let _ = unsafe { EndUpdateResourceW(handle, true) };
+        return Err(e).context("Failed to update resource");
+    }
+
+    // Commit the changes
+    unsafe { EndUpdateResourceW(handle, false) }.context("Failed to commit resource updates")?;
+
+    Ok(())
+}
+
+/// Embeds a binary resource from a file into a Windows PE executable.
+///
+/// This is a convenience wrapper around [`embed_binary_resource`] that reads the
+/// resource data from a file.
+#[cfg(windows)]
+pub fn embed_resource_from_file(
+    executable_path: &Path,
+    resource_id: &str,
+    resource_file: &Path,
+) -> Result<()> {
+    let data = std::fs::read(resource_file)
+        .with_context(|| format!("Failed to read resource file: {}", resource_file.display()))?;
+    embed_binary_resource(executable_path, resource_id, &data)
+}
+
+/// Non-Windows stub that returns an error.
+#[cfg(not(windows))]
+pub fn embed_binary_resource(
+    _executable_path: &Path,
+    _resource_id: &str,
+    _data: &[u8],
+) -> Result<()> {
+    bail!("Resource embedding is only supported on Windows")
+}
+
+/// Non-Windows stub that returns an error.
+#[cfg(not(windows))]
+pub fn embed_resource_from_file(
+    _executable_path: &Path,
+    _resource_id: &str,
+    _resource_file: &Path,
+) -> Result<()> {
+    bail!("Resource embedding is only supported on Windows")
+}
