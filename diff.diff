+/// Scan a gzipped tar archive and compute metadata by reading tar headers.
+///
+/// This function reads through the archive entries without extracting file contents,
+/// counting files and summing their sizes. This is used at installer runtime to compute
+/// the metadata needed for disk space checks and progress display.
+pub fn scan_archive_metadata(archive_data: &[u8]) -> Result<Metadata> {
+    let decoder = GzDecoder::new(archive_data);
+    let mut archive = tar::Archive::new(decoder);
+    let mut metadata = Metadata::new();
+    for entry in archive.entries()? {
+        let entry = entry?;
+        if entry.header().entry_type().is_dir() {
+            metadata.add_directory();
+        } else {
+            metadata.add_file(entry.header().size()?);
+        }
+    }
+    Ok(metadata)
+}
