diff --git a/bazel_scripts/installer.bzl b/bazel_scripts/installer.bzl
new file mode 100644
index 0000000000..2770176a1c
--- /dev/null
+++ b/bazel_scripts/installer.bzl
@@ -0,0 +1,85 @@
+"""Rules for building the Windows installer from the Electron dist output."""
+
+DEFAULT_BUNDLER = Label("//build_tools/install/config:bundle")
+
+def _win_installer_impl(ctx):
+    dist_files = ctx.attr.dist[DefaultInfo].files.to_list()
+    if len(dist_files) != 1:
+        fail("Expected a single output from dist, got {}".format(len(dist_files)))
+    dist = dist_files[0]
+
+    installer = ctx.actions.declare_file(ctx.attr.output_name)
+    sanitized_config = ctx.actions.declare_file("electron-builder-config.json")
+    payload_archive = ctx.actions.declare_file("payload.tar.gz")
+    intermediate = ctx.actions.declare_directory(ctx.label.name + "_intermediate")
+
+    config_path = "{}/{}".format(dist.path, ctx.attr.config_name)
+    unpacked_path = "{}/{}".format(dist.path, ctx.attr.unpacked_dir)
+
+    ctx.actions.run(
+        executable = ctx.executable.bundler,
+        arguments = [
+            config_path,
+            unpacked_path,
+            intermediate.path,
+            installer.path,
+            sanitized_config.path,
+            payload_archive.path,
+            ctx.executable.prebuilt_installer.path,
+            ctx.executable.prebuilt_uninstaller.path,
+        ],
+        inputs = [dist],
+        tools = [
+            ctx.executable.bundler,
+            ctx.executable.prebuilt_installer,
+            ctx.executable.prebuilt_uninstaller,
+        ],
+        outputs = [installer, sanitized_config, payload_archive, intermediate],
+        progress_message = "Building Windows installer for {}".format(ctx.label),
+        mnemonic = "WinInstaller",
+    )
+
+    return [
+        DefaultInfo(files = depset([installer, sanitized_config, payload_archive])),
+    ]
+
+win_installer = rule(
+    implementation = _win_installer_impl,
+    attrs = {
+        "dist": attr.label(
+            allow_single_file = True,
+            mandatory = True,
+        ),
+        "bundler": attr.label(
+            default = DEFAULT_BUNDLER,
+            executable = True,
+            cfg = "exec",
+            doc = "Executable bundler binary (rules_rust).",
+        ),
+        "prebuilt_installer": attr.label(
+            mandatory = True,
+            executable = True,
+            cfg = "exec",
+            doc = "Prebuilt installer binary (rules_rust).",
+        ),
+        "prebuilt_uninstaller": attr.label(
+            mandatory = True,
+            executable = True,
+            cfg = "exec",
+            doc = "Prebuilt uninstaller binary (rules_rust).",
+        ),
+        "output_name": attr.string(
+            default = "enso-win-installer.exe",
+            doc = "File name of the produced installer executable.",
+        ),
+        "config_name": attr.string(
+            default = "electron-builder-config.yaml",
+            doc = "Path to the electron-builder config JSON relative to the dist directory.",
+        ),
+        "unpacked_dir": attr.string(
+            default = "win-unpacked",
+            doc = "Path to the unpacked Electron bundle relative to the dist directory.",
+        ),
+    },
+    doc = "Packages the Windows Electron distribution into the Rust-based installer.",
+)
