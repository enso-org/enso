@@ -0,0 +1,45 @@
+use enso_install_config::bundler;
+use enso_install_config::prelude::*;
+
+use std::env;
+use std::path::PathBuf;
+
+fn main() -> Result {
+    let mut args = env::args_os().skip(1);
+
+    let electron_builder_config =
+        args.next().map(PathBuf::from).context("Missing path to electron-builder config JSON")?;
+    let unpacked_electron_bundle =
+        args.next().map(PathBuf::from).context("Missing path to unpacked electron bundle")?;
+    let intermediate_dir =
+        args.next().map(PathBuf::from).context("Missing path to intermediate directory")?;
+    let output_file =
+        args.next().map(PathBuf::from).context("Missing path to output installer executable")?;
+    let sanitized_config_path =
+        args.next().map(PathBuf::from).context("Missing path to sanitized config output")?;
+    let payload_out =
+        args.next().map(PathBuf::from).context("Missing path to payload archive output")?;
+    let installer_binary = args.next().map(PathBuf::from);
+    let uninstaller_binary = args.next().map(PathBuf::from);
+
+    // Repo root defaults to current working directory; Bazel will set cwd appropriately.
+    let repo_root = env::current_dir().context("Failed to determine current working directory")?;
+
+    ensure!(args.next().is_none(), "Unexpected extra arguments provided to bundler");
+
+    let config = bundler::Config {
+        electron_builder_config,
+        sanitized_config_path,
+        payload_out,
+        unpacked_electron_bundle,
+        repo_root,
+        output_file,
+        intermediate_dir,
+        certificate: None,
+        installer_binary,
+        uninstaller_binary,
+    };
+
+    let rt = tokio::runtime::Runtime::new()?;
+    rt.block_on(bundler::bundle(config))
+}
