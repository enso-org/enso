import project.Data.Boolean.Boolean.False

@Builtin_Type
type Any
    catch self error_type=Any handler=(x->x) =
        _ = error_type
        handler self
    to_text self = any_to_text self
    to_display_text self = any_to_display_text self
    is_error self = False
    == self other = any_equals self other
    != self other = (self == other).not
    < self other = Default_Comparator.less_than_builtin self other
    <= self other = Default_Comparator.less_than_builtin self other || Any.== self other
    > self other = Default_Comparator.less_than_builtin other self
    >= self other = Default_Comparator.less_than_builtin other self || Any.== other self

type Default_Comparator
    ## ---
       private: true
       ---
    less_than_builtin left right = @Builtin_Method "Default_Comparator.less_than_builtin"

any_to_text obj = @Builtin_Method "Any_Helpers.to_text"
any_to_display_text obj = @Builtin_Method "Any_Helpers.to_display_text"
any_catch_primitive obj handler = @Builtin_Method "Any_Helpers.catch_primitive"
any_equals o1 o2 = @Builtin_Method "Any_Helpers.any_equals"
catch_primitive handler = @Builtin_Method "Any_Helpers.catch_primitive"
