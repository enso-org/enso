from Standard.Base import all

from Standard.Test import Bench

polyglot java import java.lang.System as Java_System
polyglot java import java.io.File as Java_File

type Data
    private Value ~enso_bin:File ~prj:File

    bench_tests self extra_params=[] jvm=False =
        jvm_args = if jvm then [ "--jvm" ] else []
        self.startup jvm_args+["--run", self.prj.to_text]+extra_params

    startup self  args =
        exe = self.enso_bin
        result = Process.run exe.path args
        case result.exit_code of
            Exit_Code.Failure code ->
                IO.println "Process: "+exe.to_text+" with "+(args.join " ")
                IO.println "Exit code: "+code.to_text
                IO.println result.stdout
                IO.println result.stderr
                Panic.throw "Exit code: "+code.to_text
            Exit_Code.Success ->
                Nothing

collect_benches = Bench.build builder->
    options = Bench.options . set_warmup (Bench.phase_conf 1 10) . set_measure (Bench.phase_conf 2 10)

    exe = find_enso_bin
    data = Data.Value exe (copy_test_prj exe "Generic_JDBC_Tests")

    builder.group "Compare_JVM_Modes" options group_builder->
        group_builder.specify "Empty_Tests" <|
            data.bench_tests jvm=True [ "NoTestFilter" ]
        group_builder.specify "Empty_Dual_Tests" <|
            data.bench_tests [ "--vm.D=polyglot.enso.classLoading=guest", "NoTestFilter" ]
        group_builder.specify "Empty_Dual_JVM_Tests" <|
            data.bench_tests jvm=True [ "--vm.D=polyglot.enso.classLoading=guest", "NoTestFilter" ]
        group_builder.specify "Single_JVM_Tests" <|
            data.bench_tests jvm=True [ "should.be.able.to.insert..update" ]
        group_builder.specify "Single_Dual_Tests" <|
            data.bench_tests [ "--vm.D=polyglot.enso.classLoading=guest", "should.be.able.to.insert..update" ]
        group_builder.specify "Single_Dual_JVM_Tests" <|
            data.bench_tests jvm=True [ "--vm.D=polyglot.enso.classLoading=guest", "should.be.able.to.insert..update" ]

private copy_test_prj bin:File name:Text -> File =
    repo_root e =
        if e/".git" . exists then e else
            @Tail_Call repo_root e.parent
            
    target = File.create_temporary_file
    target.delete

    install_dir = repo_root bin
    prj = install_dir / "test" / name
    Runtime.assert prj.is_directory "Found directory "+prj.to_text

    copy s d =
        if s.is_directory.not then s.copy_to d else
            d.create_directory
            s.list . map f->
                copy f d/f.name
    
    copy prj target
    
    yaml = target/"package.yaml"
    yaml_text = yaml.read_text
    IO.println "Read in:"+yaml_text
    new_text = yaml_text . replace "jvm: true" ""
    replace = new_text.write path=yaml
    IO.println "Replacing "+replace.to_text
    IO.println "Enso project created at "+target.to_text
    
    target


private find_enso_bin =
    find_prefix dir prefix =
        vec = dir.list name_filter=prefix+"*"
        if vec.length == 1 then vec.at 0 else
            msg_prefix = if vec.length == 0 then "Cannot find " else "Found multiple "
            msg = msg_prefix + prefix + "* in " + dir.to_text + '\n'
            err = dir.list.fold msg t-> f->
                t + f.to_text + '\n'
            Panic.throw err

    project_root = File.new enso_project.root.to_text
    repository_root = project_root . parent . parent
    built_distribution = find_prefix repository_root "built-distribution"
    enso_engine = find_prefix built_distribution "enso-engine-"
    enso = find_prefix enso_engine "enso-"
    bin = find_prefix enso "bin"

    exe = File.new bin / if Platform.os == Platform.OS.Windows then "enso.bat" else "enso"

    if exe.is_regular_file.not then Panic.throw "Cannot find "+exe.to_text

    IO.println "Found Enso executable:"+exe.to_text
    exe

main = collect_benches . run_main
