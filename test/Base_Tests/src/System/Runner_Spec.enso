from Standard.Base import all
from Standard.Test import all

polyglot java import java.io.File as Java_File
polyglot java import java.lang.System as Java_System

add_specs suite_builder =
    suite_builder.group "Engine runner" group_builder->
        group_builder.specify "should change working dir before executing a project" <|
            tmp_dir = create_tmp_dir / "Projects"
            tmp_dir.create_directory
            tmp_dir.is_directory . should_be_true
            create_new_enso_project (tmp_dir / "Project")
            proj_dir = tmp_dir / "Project"
            Test.with_clue "New project creation should succeed" <|
                proj_dir.is_directory . should_be_true
            main = proj_dir / "src" / "Main.enso"
            main.exists . should_be_true
            main_src = """
                from Standard.Base import all
                main =
                    file = File.new "README.txt"
                    file.absolute.path

            main_src . write main on_existing_file=Existing_File_Behavior.Overwrite
            # Ensure that the subprocess runs without any warnings or errors
            stdout = execute_project proj_dir
            expected_path = (tmp_dir / "README.txt").absolute.path
            stdout . should_equal expected_path


## Executes a project and expects no output in stdout and stderr
execute_project proj_dir:File -> Text =
    proj_dir.is_directory . should_be_true
    res = Process.run enso_bin.path ["--run", proj_dir.absolute.path]
    res.exit_code . should_equal Exit_Code.Success
    clue = "Expected empty stderr from subprocess: "
        + "stderr was '"
        + res.stderr
        + "'"
    Test.with_clue clue <|
        res.stderr.is_empty . should_be_true
    res.stdout.trim

create_tmp_dir -> File =
    tmp_file = File.create_temporary_file
    tmp_file.delete
    tmp_file.create_directory
    tmp_file

create_new_enso_project dir:File =
    res = Process.run enso_bin.path [ "--new", dir.path ]
    IO.println res.stdout
    IO.println res.stderr
    res.exit_code . should_equal Exit_Code.Success
    dir

bin_dir =
    p = Java_System.getProperty "jdk.module.path"
    s = p.split Java_File.separator
    paths = s.take (..While _!="..")
    j = paths . join Java_File.separator
    File.new j

enso_bin =
    bin_dir / if Platform.os == Platform.OS.Windows then "enso.bat" else "enso"

main filter=Nothing =
    suite = Test.build suite_builder->
        add_specs suite_builder
    suite.run_with_filter filter
