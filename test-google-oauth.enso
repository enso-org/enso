from Standard.Base import all
import Standard.Base.Errors.Illegal_State.Illegal_State
import Standard.Base.Data.Base_64.Base_64

import Standard.Base.Enso_Cloud.Internal.Existing_Enso_Asset.Existing_Enso_Asset
import Standard.Base.Enso_Cloud.Internal.Utils as Cloud_Utils

from Standard.Google_Api import all

polyglot java import java.lang.System as Java_System

api_root = URI.from Cloud_Utils.cloud_root_uri

redirect_uri = api_root / "oauth/google/callback"


create_credential name scopes =
    nonce = Random.uuid
    client_id = Environment.get "GOOGLE_APP_CLIENT_ID"
        . if_nothing (Panic.throw (Illegal_State.Error "Missing env var"))

    parent_dir = Enso_File.home
    parent_dir_asset = Existing_Enso_Asset.get_asset_reference_for parent_dir

    IO.println "Creating credential "+name+" in "+parent_dir.to_text

    # Create credential in Cloud
    input = JS_Object.from_pairs <|
        [["type", "Google"], ["scopes", scopes]]
    metadata = JS_Object.from_pairs <|
        [["input", input], ["nonce", nonce]]
    request_payload = JS_Object.from_pairs <|
        [["name", name], ["value", metadata], ["parentDirectoryId", parent_dir_asset.id]]
    IO.println "Request payload = "+request_payload.to_text
    secret_id = Cloud_Utils.http_request_as_json ..Post (api_root / "secrets") request_payload
    IO.println "Successfully created initial credential "+(secret_id:Text)

    if secret_id.is_error then secret_id

    state_payload = JS_Object.from_pairs <|
        [["secretId", secret_id], ["nonce", nonce]]
    IO.println "State payload = "+state_payload.to_text
    encoded_state = Base_64.encode_text state_payload.to_json

    # Generate user URL
    base_uri = URI.from "https://accounts.google.com/o/oauth2/v2/auth"
    open_uri = base_uri
        . add_query_argument "response_type" "code"
        . add_query_argument "access_type" "offline"
        . add_query_argument "prompt" "consent"
        . add_query_argument "client_id" client_id
        . add_query_argument "redirect_uri" redirect_uri.to_text
        . add_query_argument "scope" (scopes.join " ")
        . add_query_argument "state" encoded_state
    IO.println open_uri

    Enso_Secret.get name

main =
    IO.println redirect_uri
    name = "test-google-cred-"+(Date_Time.now.format "yyyy-MM-dd_HH-mm-ss")
    scopes = ["https://www.googleapis.com/auth/spreadsheets", "https://www.googleapis.com/auth/drive"]
    credential = create_credential name scopes

    IO.println '\n\nPress Enter once the authentication is complete\n\n'
    Java_System.console.readLine
    IO.println '\nNow trying to authenticate using these credentials\n\n'

    google_sheets = Google_Sheets.initialize credential
    table = google_sheets.get_table "1Xa1cXLN4oeCl7FpD_IErfOMHhFuShpc1S5Buc0UF4b0" "Sheet1"
    IO.println table
    table.print
